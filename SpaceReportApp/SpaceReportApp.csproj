<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>SpaceReport</AssemblyName>
    <RootNamespace>SpaceReportApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.2</Version>

    <!-- Single-file publish: bundle the native libraries too (WebView2Loader and
         the WPF natives), compress the payload, and leave out symbols and the
         dependency XML docs so the download is one clean executable. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <Product>Space Report</Product>
    <Description>Shows what is using disk space, what each item is, and whether it can safely be deleted.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <!-- ApplicationIcon embeds the icon in the exe; WPF then uses it for the
       window and taskbar automatically. Do NOT also set Icon="app.ico" on the
       Window - that needs a separate <Resource> and throws XamlParseException
       at startup if it is missing, which kills the app before it draws. -->


  <ItemGroup>
    <!-- The UI, and the engine it drives.
         Embedded so that a published single-file build really is one file, and
         also copied next to the exe so ordinary `dotnet build` runs pick up
         edits without a republish. The app prefers the loose copies when they
         exist and unpacks the embedded ones otherwise. -->
    <EmbeddedResource Include="ui.html" LogicalName="ui.html"
                      CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Get-SpaceReport.ps1" Link="Get-SpaceReport.ps1"
                      LogicalName="Get-SpaceReport.ps1"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
